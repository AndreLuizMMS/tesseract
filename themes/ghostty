# themes/ghostty
# Ghostty theme. Copy to ~/.config/ghostty/themes/tesseract-neon and use:
#   theme = tesseract-neon
#
# Ghostty accepts hex with or without "#". Kept without "#" since that's the
# form used by the built-in themes.

palette = 0=#070B0C
palette = 1=#C22F38
palette = 2=#1F7A4C
palette = 3=#C9A227
palette = 4=#3E7FA8
palette = 5=#8B4FC4
palette = 6=#128C86
palette = 7=#BFD1C6
palette = 8=#3E534E
palette = 9=#FF3B47
palette = 10=#55FFA6
palette = 11=#FFB454
palette = 12=#7DB7E8
palette = 13=#C77DFF
palette = 14=#22E0D0
palette = 15=#E8F4EC

background = 070B0C
foreground = BFD1C6

cursor-color = 55FFA6
cursor-text = 030507

selection-background = 121C1F
selection-foreground = E8F4EC

# Split divider: structure, cyan. The palette doesn't define an inactive
# split color, so only the active one is declared.
split-divider-color = 128C86

# No surface effect inside the terminal.
background-opacity = 1
unfocused-split-opacity = 1
