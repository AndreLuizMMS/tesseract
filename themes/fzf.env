# themes/fzf.env
# fzf colors for Tesseract Neon. Load in the shell:
#   source ~/.config/fzf/tesseract-neon.env
#
# Rule: the frame, the prompt and the search match are structure → cyan.
# The pointer is where your keyboard is → it's the only phosphor green on
# screen. Marking a selected item is orange, never green.
#
# Sharp borders (--border=sharp): rounded corner is forbidden.
# No forced --ansi and no surface effect.

export FZF_DEFAULT_OPTS="
--border=sharp
--prompt='⧉ '
--pointer='▸'
--marker='▓'
--separator='─'
--scrollbar='│'
--color=fg:#BFD1C6,fg+:#E8F4EC,bg:#070B0C,bg+:#121C1F
--color=hl:#22E0D0,hl+:#22E0D0
--color=info:#128C86,prompt:#128C86,pointer:#55FFA6
--color=marker:#FFB454,spinner:#6C8076,header:#6C8076
--color=border:#16282A,separator:#16282A,scrollbar:#16282A
--color=label:#128C86,query:#E8F4EC
--color=disabled:#3E534E,gutter:#070B0C
"

# No color at all when NO_COLOR is set: fzf stays legible through the
# ▸ pointer, the ▓ mark, and the bold highlight of the match.
if [ -n "${NO_COLOR:-}" ]; then
  export FZF_DEFAULT_OPTS="
--border=sharp
--prompt='⧉ '
--pointer='▸'
--marker='▓'
--color=bw
"
fi
