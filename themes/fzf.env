# themes/fzf.env
# Cores do fzf no Tesseract Neon. Carregue no shell:
#   source ~/.config/fzf/tesseract-neon.env
#
# Regra: a moldura, o prompt e o casamento de busca são estrutura → ciano.
# O ponteiro é onde o seu teclado está → é o único verde phosphor da tela.
# Marcação de item selecionado é laranja, nunca verde.
#
# Bordas afiadas (--border=sharp): canto arredondado é proibido.
# Sem --ansi forçado e sem efeito de superfície.

export FZF_DEFAULT_OPTS="
--border=sharp
--prompt='⧉ '
--pointer='▸'
--marker='▓'
--separator='─'
--scrollbar='│'
--color=fg:#BFD1C6,fg+:#E8F4EC,bg:#070B0C,bg+:#121C1F
--color=hl:#22E0D0,hl+:#22E0D0
--color=info:#128C86,prompt:#128C86,pointer:#55FFA6
--color=marker:#FFB454,spinner:#6C8076,header:#6C8076
--color=border:#16282A,separator:#16282A,scrollbar:#16282A
--color=label:#128C86,query:#E8F4EC
--color=disabled:#3E534E,gutter:#070B0C
"

# Sem cor nenhuma quando NO_COLOR está de pé: o fzf continua legível pelo
# ponteiro ▸, pela marca ▓ e pelo destaque em negrito do casamento.
if [ -n "${NO_COLOR:-}" ]; then
  export FZF_DEFAULT_OPTS="
--border=sharp
--prompt='⧉ '
--pointer='▸'
--marker='▓'
--color=bw
"
fi
