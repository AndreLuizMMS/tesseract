# themes/delta.gitconfig
# Tesseract Neon [delta] section.
#
# Include in ~/.gitconfig:
#   [include]
#       path = ~/path/to/tesseract/themes/delta.gitconfig
#
# Depends on the syntax theme installed from themes/bat.tmTheme.
#
# Diff rule: an added line uses dark green brand.core, never the phosphor —
# a long diff would repeat #55FFA6 hundreds of times, and it exists once per
# screen. File header and frame are cyan, because they're structure.
# Conflict is blocking orange: it asks for your hand.

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[delta]
	syntax-theme = Tesseract Neon
	navigate = true
	line-numbers = true
	hyperlinks = true
	true-color = always
	tabs = 4

	# No rounded corner: only straight lines.
	file-style = "#E8F4EC" bold
	file-decoration-style = "#128C86" ul
	hunk-header-style = syntax
	hunk-header-decoration-style = "#16282A" box
	hunk-header-file-style = "#22E0D0"
	hunk-header-line-number-style = "#128C86"

	minus-style = syntax "#0C1315"
	minus-emph-style = "#E8F4EC" "#C22F38"
	minus-non-emph-style = syntax "#0C1315"

	plus-style = syntax "#0C1315"
	plus-emph-style = "#030507" "#1F7A4C"
	plus-non-emph-style = syntax "#0C1315"

	zero-style = syntax

	line-numbers-minus-style = "#C22F38"
	line-numbers-plus-style = "#1F7A4C"
	line-numbers-zero-style = "#3E534E"
	line-numbers-left-style = "#16282A"
	line-numbers-right-style = "#16282A"

	whitespace-error-style = "#030507" "#FF3B47"

	# Moved blocks: blue and purple, the two families that are neither state,
	# nor ownership, nor structure.
	map-styles = \
		bold purple => syntax "#121C1F", \
		bold blue => syntax "#0C1315"

	merge-conflict-begin-symbol = "▓"
	merge-conflict-end-symbol = "▓"
	merge-conflict-ours-diff-header-style = "#FFB454" bold
	merge-conflict-ours-diff-header-decoration-style = "#16282A" box
	merge-conflict-theirs-diff-header-style = "#FFB454" bold
	merge-conflict-theirs-diff-header-decoration-style = "#16282A" box

	blame-palette = "#070B0C" "#0C1315" "#121C1F" "#16282A"

	# grep and search
	grep-file-style = "#22E0D0"
	grep-line-number-style = "#128C86"

[delta "no-color"]
	# Profile for NO_COLOR=1 / dumb terminal: use with
	#   git -c delta.features=no-color diff
	# Everything in plain text; the signal is still the +/- of the column and bold.
	syntax-theme = none
	line-numbers = true
	minus-style = normal
	plus-style = bold
	minus-emph-style = reverse
	plus-emph-style = reverse
	file-style = bold
	hunk-header-style = normal
