// themes/windows-terminal.json
// Fragment of the "schemes" array from Windows Terminal's settings.json.
// Paste the objects inside the "schemes" that already exists in your settings.json.
//
// Decisions not covered by the palette:
// - Windows Terminal has no key for the color of the TEXT under the cursor
//   (cursor_text #030507). The cursor is solid #55FFA6 and the terminal
//   inverts the glyph on its own. Nothing was invented.
// - "selectionForeground" doesn't exist in Windows Terminal's schema; only
//   "selectionBackground". The selection fg (#E8F4EC) has no home here.
{
  "schemes": [
    {
      "name": "Tesseract Neon",

      "background": "#070B0C",
      "foreground": "#BFD1C6",
      "cursorColor": "#55FFA6",
      "selectionBackground": "#121C1F",

      "black": "#070B0C",
      "red": "#C22F38",
      "green": "#1F7A4C",
      "yellow": "#C9A227",
      "blue": "#3E7FA8",
      "purple": "#8B4FC4",
      "cyan": "#128C86",
      "white": "#BFD1C6",

      "brightBlack": "#3E534E",
      "brightRed": "#FF3B47",
      "brightGreen": "#55FFA6",
      "brightYellow": "#FFB454",
      "brightBlue": "#7DB7E8",
      "brightPurple": "#C77DFF",
      "brightCyan": "#22E0D0",
      "brightWhite": "#E8F4EC"
    }
  ]
}
